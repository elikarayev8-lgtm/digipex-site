{
  "name": "Digipex CBCT Baxış",
  "short_name": "Digipex CBCT",
  "description": "CBCT / DICOM baxış, panoramik görüntü, implant planlaması və 2D rentgen simulyatoru. Fayllar cihazdan kənara çıxmır.",
  "lang": "az",
  "start_url": "cbct.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0A0F18",
  "theme_color": "#0E1420",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    { "action": "cbct.html", "accept": { "application/dicom": [".dcm"], "application/zip": [".zip"] } }
  ]
}
